{
  "name": "npm-install",
  "version": "1.0.0",
  "description": "基于 Verdaccio 的私有 npm 仓库管理系统 - 支持自动依赖解析",
  "main": "index.js",
  "scripts": {
    "start": "verdaccio --config ./verdaccio/config.yaml",
    "add-package": "node scripts/add-package.js",
    "add-deps": "node scripts/add-package-with-deps.js",
    "batch-download": "node scripts/batch-download.js",
    "download-and-publish": "node scripts/download-and-publish.js",
    "analyze-deps": "node scripts/analyze-deps.js",
    "sync-to-offline": "node scripts/sync-to-offline.js",
    "generate-docs": "node scripts/generate-docs.js",
    "publish-to-internal": "node scripts/publish-to-internal.js",
    "publish-local": "node scripts/publish-local.js",
    "check-setup": "node scripts/check-setup.js",
    "diagnose": "node scripts/diagnose-packages.js",
    "clean-duplicates": "node scripts/clean-duplicates.js",
    "check-verdaccio": "node scripts/check-verdaccio-status.js",
    "configure-internal": "node scripts/configure-internal-registry.js",
    "check-publish-setup": "node scripts/check-publish-setup.js",
    "clean-cache": "node scripts/clean-npm-cache.js",
    "test-safety": "node scripts/test-publish-safety.js",
    "test": "jest",
    "lint": "eslint .",
    "build": "tsc",
    "dev": "ts-node src/index.ts",
    "analyze-deps-new": "node src/cli.js analyze",
    "fix-deps": "node src/cli.js fix",
    "check-integrity": "node src/cli.js check"
  },
  "keywords": [
    "verdaccio",
    "npm",
    "private",
    "registry",
    "dependencies"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "axios": "^1.6.0",
    "commander": "^11.1.0",
    "crypto": "^1.0.1",
    "fs-extra": "^11.2.0",
    "js-yaml": "^4.1.0",
    "lodash": "^4.17.21",
    "tar": "^7.0.0",
    "verdaccio": "^5.0.0",
    "yaml": "^2.3.4"
  },
  "devDependencies": {
    "@element-plus/icons-vue": "^2.3.1",
    "@rollup/rollup-win32-x64-msvc": "^4.60.2",
    "@types/jest": "^29.5.8",
    "@types/lodash": "^4.17.23",
    "@types/node": "^20.10.0",
    "@typescript-eslint/eslint-plugin": "8.57.1",
    "@typescript-eslint/parser": "8.57.1",
    "@vitejs/plugin-vue": "^5.0.0",
    "@vue/compiler-sfc": "^3.5.0",
    "@vue/test-utils": "2.4.0",
    "element-plus": "^2.13.0",
    "eslint": "^8.57.0",
    "eslint-plugin-vue": "^9.14.1",
    "fast-glob": "^3.3.3",
    "jest": "^29.7.0",
    "js-yaml": "^4.1.1",
    "jsdom": "21.1.0",
    "lodash": "^4.18.1",
    "pinia": "^3.0.4",
    "prismjs": "^1.30.0",
    "sass": "1.77.6",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.1",
    "typescript": "^5.4.0",
    "uuid": "^8.3.2",
    "vite": "^5.4.0",
    "vitest": "^2.1.8",
    "vue": "^3.4.0",
    "vue-router": "^4.6.4"
  }
}
