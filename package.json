{
  "name": "npm-install",
  "version": "1.0.0",
  "description": "基于 Verdaccio 的私有 npm 仓库管理系统 - 支持自动依赖解析",
  "main": "index.js",
  "scripts": {
    "start": "verdaccio --config ./verdaccio/config.yaml",
    "add-package": "node scripts/add-package.js",
    "add-deps": "node scripts/add-package-with-deps.js",
    "batch-download": "node scripts/batch-download.js",
    "analyze-deps": "node scripts/analyze-deps.js",
    "sync-to-offline": "node scripts/sync-to-offline.js",
    "generate-docs": "node scripts/generate-docs.js",
    "publish-to-internal": "node scripts/publish-to-internal.js",
    "check-setup": "node scripts/check-setup.js",
    "diagnose": "node scripts/diagnose-packages.js",
    "clean-duplicates": "node scripts/clean-duplicates.js",
    "check-verdaccio": "node scripts/check-verdaccio-status.js",
    "configure-internal": "node scripts/configure-internal-registry.js",
    "check-publish-setup": "node scripts/check-publish-setup.js",
    "clean-cache": "node scripts/clean-npm-cache.js"
  },
  "keywords": [
    "verdaccio",
    "npm",
    "private",
    "registry",
    "dependencies"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@types/node": "^25.6.0",
    "axios": "^1.6.0",
    "fs-extra": "^11.0.0",
    "nwsapi": "^2.2.23",
    "rollup": "^4.60.2",
    "verdaccio": "^5.0.0",
    "@element-plus/icons-vue": "^2.3.1",
    "element-plus": "2.13.0",
    "prismjs": "^1.30.0",
    "vue": "^3.4.0",
    "vue-router": "^4.6.4",
    "@typescript-eslint/eslint-plugin": "8.57.1",
    "@typescript-eslint/parser": "8.57.1",
    "@vitejs/plugin-vue": "^5.0.0",
    "@vue/compiler-sfc": "^3.5.0",
    "eslint": "^8.57.0",
    "eslint-plugin-vue": "^9.14.1",
    "typescript": "^5.4.0",
    "vite": "^5.4.0",
    "@vue/test-utils": "2.4.0",
    "jsdom": "21.1.0",
    "vitest": "0.25.0"
  }
}
